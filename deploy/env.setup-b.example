# Setup B stack environment template.
#
# Copy to .env.setup-b at the repo root on the node and fill the password
# (the rpcauth.py plaintext, stored in 1Password). The file stays out of
# git; never commit a filled copy.
#
# Usage:
#   cp deploy/env.setup-b.example .env.setup-b
#   nano .env.setup-b
#   docker compose -f docker-compose.setup-b.yml --env-file .env.setup-b up -d --build

VELDRA_BITCOIND_RPC_USER=veldra
VELDRA_BITCOIND_RPC_PASS=TODO_PASTE_RPC_PASSWORD

# observe = read-only wiring validation. Flip to shadow for the soak,
# then run `up -d` again to recreate the stack in the new mode.
VELDRA_MODE=observe

# ── Verifier ingress (PB-26, PB-27) ──
# All three match the shipped defaults; they are listed so the soak node
# is configured explicitly rather than by omission.
#
# MAX_CONNECTIONS is the concurrency cap and, at 20 MiB of line buffer
# per admitted connection, the ingress memory bound. MAX_CONNECTIONS_PER_IP
# stops one source address taking every slot (0 disables it).
# IDLE_TIMEOUT_SECS closes a connection that has made no progress in
# either direction for that long, measured since the last byte that
# moved, so a slow multi-megabyte raw_block_hex line still completes.
VELDRA_VERIFIER_MAX_CONNECTIONS=32
VELDRA_VERIFIER_MAX_CONNECTIONS_PER_IP=20
VELDRA_VERIFIER_IDLE_TIMEOUT_SECS=60
