# Production environment template.
#
# Copy to .env (or mount via secrets manager) and fill every TODO field.
# The system will fail at startup if required values are missing.
#
# Key differences from .env.example (dev):
#   - No default credentials
#   - VELDRA_LOG_FORMAT=json (structured, not pretty)
#   - VELDRA_AUTH_TRUST_PROXY=1 (typical behind load balancer)
#   - VELDRA_MODE=inline (or observe for read-only evaluation)

# ── Deployment mode ──
VELDRA_MODE=inline

# ── Logging ──
VELDRA_LOG_FORMAT=json
VELDRA_LOG_FILTER=info

# ── Verifier ingress (PB-26, PB-27) ──
# Maximum concurrent NDJSON connections the pool-verifier will admit.
# The ingress accepts unauthenticated peers and every admitted
# connection can hold a line buffer up to 20 MiB (mainnet
# raw_block_hex), so this doubles as the ingress memory bound: roughly
# 640 MiB at 32.
#
# Size it from the real connection count, not from miner count. Each
# sv2-gateway holds one persistent stream. Each template-manager does
# NOT: it opens a fresh TCP connection per template and drops it once
# the verdict comes back, so it needs a free slot every poll interval
# and holds one only for the length of a round trip. A pool with 4
# gateways and 2 managers sits in the single digits at any instant, not
# in the hundreds. Raise this only if
# verifier_connections_refused_total starts ticking with no attacker
# present; that counter is the signal that the cap is below the
# deployment's real service count.
VELDRA_VERIFIER_MAX_CONNECTIONS=32

# Maximum concurrent connections from any one source address. The cap
# above is global, so without this one address can hold every slot and
# lock the pool's own gateway and template-manager out; because the
# manager reconnects per template, that stops verdicts entirely and
# drives the gateway's auto_degrade. PB-31 sized 20 as 2G + M + 1 for
# the largest legitimate single-address population, a NAT or L4 proxy
# collapsing a whole deployment's egress onto one address at the
# documented single-digit stream ceiling: G = 8 gateways at two slots
# each, because a silently dead socket holds its slot for the full
# IDLE_TIMEOUT_SECS below while the gateway reconnects in 2 to 3 s, plus
# one concurrent template-manager, plus one diagnostic connection. Raise
# it if your deployment runs more gateway streams than that behind one
# address. Set to 0 only when every legitimate peer reaches the verifier
# through a single L4 proxy address, which leaves no per-IP signal to
# enforce on. Watch verifier_connections_refused_per_ip_total: unlike
# the global counter, raising MAX_CONNECTIONS does not help it.
VELDRA_VERIFIER_MAX_CONNECTIONS_PER_IP=20

# Seconds an ingress connection may make no progress in either
# direction before it is closed and its slot returned. Measured since
# the last byte that actually moved, never from the connection's start,
# so a 20 MiB raw_block_hex line arriving slowly is not reaped. Must
# stay comfortably above the gateway's verifier.heartbeat_interval_ms
# (default 5000); 60 leaves twelve intervals of headroom. Watch
# verifier_connections_reaped_idle_total and
# verifier_connections_active: a steady reap rate with no attacker
# means this is below a legitimate peer's real silence, and a gauge
# pinned near MAX_CONNECTIONS means slots are being held.
#
# verifier_connections_reaped_handshake_total is a different kill and
# this knob does not affect it: that one is the TLS handshake budget, a
# hardcoded constant, and a tick there means a peer took a slot and
# never started TLS.
VELDRA_VERIFIER_IDLE_TIMEOUT_SECS=60

# ── Bitcoin Core ──
VELDRA_BITCOIND_RPC_USER=TODO_SET_RPC_USER
VELDRA_BITCOIND_RPC_PASS=TODO_SET_RPC_PASS

# ── API Authentication ──
# Generate with: reservegrid keygen
VELDRA_API_SECRET=TODO_SET_API_SECRET_MIN_32_HEX
VELDRA_API_SECRET_PREVIOUS=
VELDRA_HMAC_KEY=

# ── rg-auth ──
VELDRA_AUTH_ALLOWED_ORIGIN=TODO_SET_FRONTEND_ORIGIN
VELDRA_AUTH_SITE_URL=TODO_SET_FRONTEND_URL
VELDRA_AUTH_URL=TODO_SET_AUTH_SERVICE_URL
VELDRA_AUTH_TRUST_PROXY=1
VELDRA_AUTH_SESSION_TTL_HOURS=168
VELDRA_AUTH_RATE_MAX_IPS=10000
VELDRA_AUTH_RATE_GLOBAL_CEILING=

# ── SMTP (required for email verification) ──
VELDRA_AUTH_SMTP_HOST=TODO_SET_SMTP_HOST
VELDRA_AUTH_SMTP_PORT=587
VELDRA_AUTH_SMTP_USER=TODO_SET_SMTP_USER
VELDRA_AUTH_SMTP_PASS=TODO_SET_SMTP_PASS

# ── TLS ──
VELDRA_TLS_CERT=
VELDRA_TLS_KEY=
VELDRA_TLS_SELF_SIGNED=0
